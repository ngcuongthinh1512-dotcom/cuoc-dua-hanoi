{
  "name": "cuoc-dua-hanoi",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "shared",
    "client",
    "worker"
  ],
  "scripts": {
    "build": "tsc -p scripts && npm run build --workspaces --if-present",
    "deploy": "npm run build && npm run deploy -w worker",
    "test": "vitest run --dir scripts && npm run test --workspaces --if-present",
    "dev": "npm run dev -w client",
    "dev:worker": "npm run dev -w worker",
    "dev:api": "npm run dev:api -w worker",
    "screenshot": "tsx scripts/screenshot.ts",
    "ride-check": "tsx scripts/ride-check.ts",
    "landmark-audit": "tsx scripts/landmark-audit.ts",
    "sim": "tsx scripts/sim.ts",
    "leg:check": "tsx scripts/leg-check.ts",
    "fetch-map": "tsx scripts/fetch-osm.ts && tsx scripts/fetch-dem.ts --flat",
    "build-chunks": "tsx scripts/build-chunks.ts",
    "ground-dem": "tsx scripts/ground-dem.ts",
    "build-graph": "tsx scripts/build-graph.ts",
    "process-assets": "tsx scripts/process-assets.ts"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^26.6.3",
    "fast-png": "^8.0.0",
    "meshoptimizer": "^1.3.0",
    "osmtogeojson": "^3.0.0-beta.5",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
