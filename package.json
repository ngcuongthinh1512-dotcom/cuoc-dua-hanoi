{
  "name": "cuoc-dua-paris",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "shared",
    "client",
    "worker"
  ],
  "scripts": {
    "build": "tsc -p scripts && npm run build --workspaces --if-present",
    "test": "vitest run --dir scripts && npm run test --workspaces --if-present",
    "dev": "npm run dev -w client",
    "dev:worker": "npm run dev -w worker",
    "screenshot": "tsx scripts/screenshot.ts",
    "fetch-map": "tsx scripts/fetch-osm.ts && tsx scripts/fetch-dem.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "fast-png": "^8.0.0",
    "osmtogeojson": "^3.0.0-beta.5",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
