{
  "name": "cuoc-dua-paris",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "shared",
    "client",
    "worker"
  ],
  "scripts": {
    "build": "tsc -p scripts && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run dev -w client",
    "dev:worker": "npm run dev -w worker",
    "screenshot": "tsx scripts/screenshot.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
