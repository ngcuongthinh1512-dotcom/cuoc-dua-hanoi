{
  "name": "@race/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build --prefix ../client && wrangler dev",
    "dev:api": "node -e \"require('fs').mkdirSync('../client/dist', { recursive: true })\" && wrangler dev",
    "build": "tsc -p . && wrangler deploy --dry-run --outdir dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@race/shared": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "wrangler": "^4.141.0"
  }
}
